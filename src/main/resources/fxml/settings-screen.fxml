<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="justServes.gui.controllers.SettingsScreenController"
            prefWidth="1100" prefHeight="694">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-strip" minHeight="48" prefHeight="48" maxHeight="48">
            <padding>
                <Insets left="16" right="16"/>
            </padding>
            <Label text="Settings" styleClass="game-title"/>
        </HBox>
    </top>

    <center>
        <StackPane>
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <VBox spacing="16" maxWidth="560" StackPane.alignment="TOP_CENTER">

                <VBox spacing="10" styleClass="settings-card">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>
                    <Label text="APPEARANCE" styleClass="panel-title"/>
                    <Label text="Theme: sets the court and the app's accent colour. It applies straight away and is remembered next time."
                           wrapText="true" styleClass="settings-help"/>
                    <FlowPane fx:id="themeBox" hgap="8" vgap="8"/>
                </VBox>

                <VBox spacing="10" styleClass="settings-card">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>
                    <Label text="APP" styleClass="panel-title"/>
                    <Label text="Serves are saved as you record them, so there is nothing to save before you close."
                           wrapText="true" styleClass="settings-help"/>
                    <HBox>
                        <Button fx:id="exitButton" text="Exit Just Serves"/>
                    </HBox>
                </VBox>

            </VBox>
        </StackPane>
    </center>

</BorderPane>